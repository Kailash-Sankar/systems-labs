REDIS_URL=redis://localhost:6379/0
DB_PATH=data/app.db
CACHE_TTL_SEC=5
DB_SLEEP_MS=200
CACHE_STRATEGY=naive

# singleflight / swr (Phase 3+)
LOCK_TTL_SEC=10
LOCK_WAIT_TIMEOUT_MS=5000
LOCK_RETRY_BACKOFF_MS=50
SWR_STALE_SEC=5

# xfetch (Phase 5) — higher beta = earlier proactive refreshes
XFETCH_BETA=1.0

# jitter (Phase 6) — extra random seconds on SETEX (percent of base TTL)
TTL_JITTER_PCT=20
